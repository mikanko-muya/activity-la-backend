model Organizer {
  id           String  @id @default(uuid()) @db.VarChar(36)
  /// Lao; nameEn and descriptionEn are the English twins.
  name          String
  nameEn        String
  email         String  @unique
  phone         String
  description   String? @db.Text
  descriptionEn String? @db.Text
  logoUrl      String?
  logoPublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events      Event[]
}