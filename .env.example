# Copy to .env and fill in. .env is gitignored and must stay that way.

DATABASE_URL="mysql://user:password@localhost:3309/db_activity_la"
PORT=6767

JWT_SECRET=
JWT_REFRESH_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used once by `npm run seed:superadmin` to bootstrap the first admin account.
# Registration always creates a USER, and only a SUPERADMIN can assign roles,
# so without this there is no way in.
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=
