model Notification {
  id String @id @default(uuid()) @db.VarChar(36)

  userId   String
  eventId  String?
  orderId  String?
  couponId String?

  /// Lao; titleEn and messageEn are the English twins. Sized to what the
  /// API accepts (200 and 1000 characters).
  title     String           @db.VarChar(200)
  titleEn   String           @db.VarChar(200)
  message   String           @db.VarChar(1000)
  messageEn String           @db.VarChar(1000)
  notifType NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
