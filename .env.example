# Copy to .env and fill in. .env is gitignored and must stay that way.

# MySQL 8+ or MariaDB 10.4+ installed on your machine (XAMPP works), on its
# usual port 3306. Put your own user and password in: XAMPP's root has none,
# so it is mysql://root@localhost:3306/db_activity_la
# With `docker compose up -d db` instead: mysql://root:root_password@localhost:3309/db_activity_la
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/db_activity_la"
PORT=6767

# Throwaway database Prisma replays migrations into when verifying them.
# Same server, different database name; it is created and dropped as needed.
# Only `npm run db:migrate:dev` uses it, so only whoever writes migrations needs it.
SHADOW_DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/db_activity_la_shadow"

# At least 32 characters each, and different. Run `npm run secret` twice.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Shared secret the payment provider sends as x-webhook-secret
PAYMENT_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used once by `npm run seed:superadmin` to bootstrap the first admin account.
# Registration always creates a USER, and only a SUPERADMIN can assign roles,
# so without this there is no way in.
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=

# PhaJay payment gateway secret key (dashboard). Server only.
PHAJAY_SECRET_KEY=

# phajay (default) issues real QRs and confirms them over PhaJay's socket.
# fake issues stand-in QRs that nothing confirms - for seeding and tests only;
# it refuses to run with NODE_ENV=production.
PAYMENT_GATEWAY=phajay
